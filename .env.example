GROUNDWORK_ENV=local

# Console
NEXT_PUBLIC_APP_NAME=Groundwork
QUERY_RUNTIME_URL=http://localhost:8080
INGESTION_RUNTIME_URL=http://localhost:8090
EMBEDDING_URL=http://localhost:8090
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_CACHE_DIR=/models/fastembed

# Console identity assertion (see deploy/vercel.env.example and docs/threat-model.md)
# Production: GROUNDWORK_JWT_RS_PRIVATE_KEY / GROUNDWORK_JWT_RS_PRIVATE_KEY_FILE (RS256).
# Local/dev: GROUNDWORK_JWT_HS_SECRET (HS256). Demo-only: GROUNDWORK_DEMO_MODE=true.
# GROUNDWORK_JWT_HS_SECRET=
# GROUNDWORK_DEMO_MODE=false

# Runtime security
IDK_THRESHOLD=0.70
ACL_TIMEOUT_MS=120
QUERY_TIMEOUT_MS=250
# IMMUTABLE_AUDIT_SALT — bound into every audit digest (write + verify,
# docs/threat-model.md L-004). Unset uses the original unsalted formula
# (fine for local/dev). When set: MUST be a strong random value (>= 16
# chars), set once, never changed afterwards. Predictable values such as
# "change-me" are refused at startup. Replace the example below with your
# own random value before any production write.
IMMUTABLE_AUDIT_SALT=example-audit-salt-017-AaBbCcDdEe

# Multi-region tenant controls
DEFAULT_RESIDENCY=uk
US_REGION=us-central1
EU_REGION=europe-west1
UK_REGION=europe-west2

# Data systems
POSTGRES_URL=postgres://groundwork:groundwork@localhost:5432/groundwork
QDRANT_URL=http://localhost:6333
ELASTICSEARCH_URL=http://localhost:9200
OBJECT_STORAGE_ENDPOINT=http://localhost:9000

# Microsoft 365 / SharePoint OAuth schema
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_REDIRECT_URI=http://localhost:3000/api/connectors/microsoft/callback

# Microsoft Graph Pilot (optional)
# Set these to enable `make connector-enumerate`. See
# services/msgraph-connector/README.md for the Azure app-registration steps.
# The connector requests only the four read-only application scopes documented
# there; no write scope is ever requested.
MSGRAPH_TENANT_ID=
MSGRAPH_CLIENT_ID=
MSGRAPH_CLIENT_SECRET=

# --- SpiceDB authorization ---
# SPICEDB_ENDPOINT=localhost:50051
# SPICEDB_TOKEN=
# SPICEDB_CONSISTENCY=minimize_latency   # minimize_latency | at_least_as_fresh | fully_consistent
# SPICEDB_INSECURE_PLAINTEXT=false       # true to disable TLS (local dev only)
# SPICEDB_CA_FILE=                       # path to a custom CA bundle (TLS)
# SPICEDB_CIRCUIT_FAILURE_LIMIT=5
# SPICEDB_CIRCUIT_OPEN_TIMEOUT_MS=10000
# SPICEDB_CIRCUIT_HALF_OPEN_LIMIT=1
# Shadow authorizer (compare two SpiceDB endpoints; primary fails closed,
# shadow is observational):
# SHADOW_AUTHORIZER=spicedb
# SPICEDB_SHADOW_ENDPOINT=localhost:50051
# SPICEDB_SHADOW_TOKEN=
# SPICEDB_SHADOW_SAMPLE_RATE=1.0
# SPICEDB_SHADOW_FALLBACK=true
