# Vercel environment for apps/console.
#
# TIER 0 (demo link): set GROUNDWORK_DEMO_MODE=true and NONE of the rest. The
# console then serves the curated Acme demo data — identical to what the live
# runtime produces. Without GROUNDWORK_DEMO_MODE, every /api route FAILS CLOSED
# (503) instead of fabricating data, so a production deploy can never silently
# serve synthetic responses.
#
# TIER 1 (live backend): set the variables below in the Vercel project
# (Project Settings -> Environment Variables).
#   * GROUNDWORK_API_KEY must exactly match the runtime's BOOTSTRAP_API_KEY.
#   * Identity assertion: prefer RS256 (TIER 2). GROUNDWORK_JWT_HS_SECRET
#     (HS256) remains for local/dev; it must match the runtime's secret.

# Public URL of the Fly runtime (Tier 1+). Leave blank for Tier 0.
QUERY_RUNTIME_URL=https://groundwork-runtime.fly.dev

# Must equal the runtime's BOOTSTRAP_API_KEY secret.
GROUNDWORK_API_KEY=gw_live_<random>

# TIER 2 (recommended): asymmetric identity assertions. The console holds the
# RSA private key (PKCS#8 PEM); the runtime only ever holds the matching public
# key (GROUNDWORK_JWT_RS_PUBLIC_KEY / _FILE), so a compromised runtime can
# never impersonate users. Inline PEM or a path on the serverless filesystem:
# GROUNDWORK_JWT_RS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----..."
# GROUNDWORK_JWT_RS_PRIVATE_KEY_FILE=/run/secrets/console-signing-key.pem
#
# Rotation: generate a new key pair, publish the new public key to the runtime,
# then replace the private key here. Assertions are short-lived (10m), so the
# rotation window is minutes.

# HS256 fallback (local/dev only — a shared secret both sides hold). If neither
# RS256 nor HS256 is configured, the console fails closed unless
# GROUNDWORK_DEMO_MODE=true (demo mode additionally requires the runtime to run
# with ALLOW_DEMO_IDENTITY=true, which the runtime refuses outside local envs).
GROUNDWORK_JWT_HS_SECRET=<32+ byte random string — identical to the runtime>

# Explicit demo-mode opt-in (Tier 0). MUST stay false/absent in production.
GROUNDWORK_DEMO_MODE=false

# Cosmetic.
NEXT_PUBLIC_APP_NAME=Groundwork