{
  "name": "groundwork-typescript",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for the Groundwork query runtime, with a Vercel AI SDK middleware wrapper.",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./integrations/llamaindex": {
      "types": "./dist/integrations/llamaindex.d.ts",
      "import": "./dist/integrations/llamaindex.js",
      "require": "./dist/integrations/llamaindex.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ai": "^5.0.0"
  },
  "peerDependencies": {
    "@ai-sdk/provider": "^1.0.0",
    "@llamaindex/core": "^0.6.0"
  },
  "devDependencies": {
    "@llamaindex/core": "^0.6.22",
    "msw": "^2.15.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
